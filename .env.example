# Polyfloor Environment Configuration
# Copy to .env and fill in values. Never commit .env files.

# Database
POLYFLOOR_DATABASE_DSN=postgresql://polyfloor:changeme@localhost:5432/polyfloor

# API Authentication
# Path to file containing the bearer token
POLYFLOOR_API_TOKEN_FILE=/path/to/api-token.txt

# ExtremeRouter (free model gateway)
POLYFLOOR_EXTREMEROUTER_BASE_URL=https://router.extreme.ai/v1
POLYFLOOR_EXTREMEROUTER_API_KEY_FILE=/path/to/extreme-router-key.txt
POLYFLOOR_EXTREMEROUTER_REASONING_MODEL=best-reasoning
POLYFLOOR_EXTREMEROUTER_FAST_MODEL=best-fast
POLYFLOOR_EXTREMEROUTER_CODE_MODEL=best-code

# Local Hermes/Ollama
POLYFLOOR_HERMES_BASE_URL=http://127.0.0.1:11434/v1
POLYFLOOR_HERMES_MODEL=hermes3

# Policy
POLYFLOOR_ALLOW_PAID_MODELS=false
POLYFLOOR_PAID_DAILY_BUDGET_USD=0

# CORS
POLYFLOOR_ALLOWED_ORIGINS=http://127.0.0.1:5173

# Server
POLYFLOOR_HOST=127.0.0.1
POLYFLOOR_PORT=8001
POLYFLOOR_LOG_LEVEL=info

# Output
POLYFLOOR_OUTPUT_ROOT=/var/lib/polyfloor/floors
