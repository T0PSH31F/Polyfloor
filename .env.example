# Polyfloor Environment Configuration
# Copy to .env and fill in values. Never commit .env files.
# All secrets are read from file paths, never from env vars directly.

# --- Server ---
POLYFLOOR_HOST=127.0.0.1
POLYFLOOR_PORT=8001
POLYFLOOR_LOG_LEVEL=info

# --- Database (SQLite WAL by default; zero external services) ---
# Override with a postgres DSN for production multi-process deployments.
POLYFLOOR_DATABASE_URL=sqlite+aiosqlite:///polyfloor.db

# --- Per-company workspace root (avatars, artifacts, workspaces) ---
POLYFLOOR_DATA_DIR=/var/lib/polyfloor

# --- Built frontend SPA to serve (optional; omit for API-only) ---
# POLYFLOOR_STATIC_DIR=/nix/store/...-polyfloor-frontend

# --- Model router (OpenAI-compatible: Kong / Extreme Router / LiteLLM) ---
# Polyfloor enumerates models via GET {POLYFLOOR_ROUTER_ENDPOINT}/models
POLYFLOOR_ROUTER_ENDPOINT=http://127.0.0.1:4000/v1
# Path to a file containing the router API key (SOPS / LoadCredential).
POLYFLOOR_ROUTER_API_KEY_FILE=/run/credentials/polyfloor.service/router-api-key

# --- Default HR coordinator model ---
POLYFLOOR_DEFAULT_HR_MODEL=mimo-v2.5-pro

# --- Security ---
# Optional platform bearer token (omit for open dev mode).
# POLYFLOOR_API_TOKEN_FILE=/run/credentials/polyfloor.service/api-token
POLYFLOOR_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- Policy ---
POLYFLOOR_DEFAULT_WIP_LIMIT=3
